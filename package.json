{
  "name": "bs9",
  "version": "1.6.7",
  "description": "Self-healing process manager for Bun with zero-downtime clustering, real-time dashboards, TypeScript build support, and durable same-host state.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./runtime": {
      "import": "./src/runtime/index.ts",
      "types": "./src/runtime/index.ts",
      "default": "./src/runtime/index.ts"
    }
  },
  "bin": {
    "bs9": "bin/bs9"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\" && bun build ./bin/bs9 --outdir ./dist --target bun",
    "dev": "bun --watch ./bin/bs9",
    "test": "bun test",
    "version:patch": "bun scripts/version-manager.js patch",
    "version:minor": "bun scripts/version-manager.js minor",
    "version:major": "bun scripts/version-manager.js major",
    "publish:patch": "bun scripts/auto-publish.js patch",
    "publish:minor": "bun scripts/auto-publish.js minor",
    "publish:major": "bun scripts/auto-publish.js major",
    "test:patch": "bun scripts/test-publish.js patch",
    "test:minor": "bun scripts/test-publish.js minor",
    "test:major": "bun scripts/test-publish.js major"
  },
  "keywords": [
    "bun",
    "process-manager",
    "sentinel",
    "cli",
    "monitoring"
  ],
  "author": "xarhang",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.50.0",
    "@opentelemetry/resources": "^1.23.0",
    "@opentelemetry/sdk-node": "^0.50.0",
    "@opentelemetry/semantic-conventions": "^1.23.0",
    "commander": "^14.0.2",
    "pino": "^9.3.1",
    "prom-client": "^15.1.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.0",
    "@types/semver": "^7.8.0",
    "bun-types": "^1.1.0",
    "express-session": "1.18.1",
    "pg": "^8.12.0",
    "typescript": "^5.7.2"
  }
}
